# Solana RPC (use Helius or QuickNode for best performance)
SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
SOLANA_WS_URL=wss://mainnet.helius-rpc.com/?api-key=YOUR_KEY

# Your Solana wallet private key (base58 encoded)
WALLET_PRIVATE_KEY=your_private_key_here

# Anthropic API key for Claude AI brain
ANTHROPIC_API_KEY=your_anthropic_key_here

# Trading settings
PAPER_TRADING=true          # Set false for real trades
BUY_AMOUNT_SOL=0.1          # SOL to spend per trade
MAX_POSITIONS=5             # Max concurrent trades
TAKE_PROFIT_PCT=150         # Take profit at +150%
STOP_LOSS_PCT=30            # Stop loss at -30%
MAX_SLIPPAGE_BPS=300        # Max slippage 3%

# Token filtering minimums
MIN_LIQUIDITY_USD=5000
MAX_DEV_WALLET_PCT=10       # Reject if dev holds > 10%
MIN_HOLDER_COUNT=50

# Optional: Helius API key for enhanced holder data
HELIUS_API_KEY=your_helius_key_here

# Web dashboard (paper trading mode)
DASHBOARD_PORT=8080
DASHBOARD_ENABLED=true
